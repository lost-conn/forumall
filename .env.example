# Forumall self-host configuration. Copy to `.env` and edit:
#
#   cp .env.example .env
#   # set DOMAIN to your real public hostname
#   docker compose up -d
#
# Only DOMAIN matters for a real deployment; EVERY other variable below has a
# safe default and may be left commented out. The server boots with no env at all
# (it falls back to a localhost authority + ./data) — that's the zero-config local
# path. The canonical source for these defaults is packages/server/src/config.ts.
# ===========================================================================

# --- Required for a real / federated deployment -----------------------------

# Public authority for this provider: the OFSCP signing authority / `iss` AND the
# hostname Caddy obtains a TLS certificate for. MUST be a real public DNS name
# pointing at this host for auto-HTTPS + federation to work. Left unset (or at the
# placeholder below) the server falls back to `localhost:<PORT>` and logs a
# warning — fine for local testing, wrong for going public.
DOMAIN=forum.example.com


# --- Networking / storage ---------------------------------------------------

# In-container port the app listens on (Caddy proxies to it). 1–65535. Default 3000.
PORT=3000

# Root directory for all server-owned state (database + media). Default ./data.
# In the Docker image this is /data (a persistent named volume). Everything you
# back up lives under here.
# DATA_DIR=./data

# Override the media directory. Default: ${DATA_DIR}/media.
# MEDIA_DIR=

# Override the SQLite database file. Default: ${DATA_DIR}/forumall.sqlite.
# DB_PATH=

# Max attachment upload size in bytes — advertised in discovery
# (capabilities.limits.maxUploadBytes) and enforced on upload. Default 26214400
# (25 MiB). Must be >= 0.
# MAX_UPLOAD_BYTES=26214400

# Optional admin contact published in the discovery document (provider.contact),
# e.g. mailto:admin@example.com. Omitted from discovery when unset.
# CONTACT=mailto:admin@example.com


# --- Deployment topology ----------------------------------------------------

# Serve the built web client as static for non-API routes. true (default) is the
# combined single-process mode (provider + UI in one process). Set false for a
# PROVIDER-ONLY deployment (API + WS only); non-API routes then 404 and you host
# the client separately (a static build, see README "Deployment modes"). The
# client is pointed at this provider at build time via VITE_PROVIDER_HOST.
# SERVE_STATIC=true


# --- Password hashing (Argon2id, §4.1.4) ------------------------------------
# Secure-by-default: the defaults equal the spec MINIMUMS and the server refuses
# to start below them. You may raise (never lower) these.

# Argon2id memory cost in KiB. Default + minimum 65536 (= 64 MiB).
# ARGON2_MEMORY_KIB=65536
# Argon2id iterations (time cost). Default + minimum 3.
# ARGON2_ITERATIONS=3
# Argon2id parallelism (lanes). Default + minimum 4.
# ARGON2_PARALLELISM=4


# --- Token / cache / timing knobs -------------------------------------------

# Bootstrap-token TTL in seconds (§4.2). Default 300. Must be >= 1.
# BOOTSTRAP_TTL_SECONDS=300

# `cache_until` window for the public keys endpoint in seconds (§4.6). Default
# 3600; capped at 3600 so revocations can't go stale. Must be 1–3600.
# USER_KEYS_CACHE_SECONDS=3600

# Message edit window in seconds (§5.3) — basis of permissions.editUntil. Default
# 900 (15 min). Must be >= 0 (0 = no edits after create).
# MESSAGE_EDIT_WINDOW_SECONDS=900

# Max post-cursor messages the WS resume path replays per channel before falling
# back to REST history (§7.1). Default 500. Must be >= 0.
# MAX_RESUME_REPLAY=500

# Typing-indicator auto-expiry window in ms (§7.1). Default 6000 (~6s). Must be
# >= 1.
# TYPING_TIMEOUT_MS=6000


# --- Federation (§8) --------------------------------------------------------

# Allow-list: comma-separated remote provider domains permitted to federate.
# Empty (default) = OPEN — every non-denied domain may federate. When non-empty,
# ONLY the listed domains may federate.
# FEDERATION_ALLOW=

# Deny-list: comma-separated remote provider domains blocked from federating.
# Empty (default) = none denied. Deny wins over the allow-list.
# FEDERATION_DENY=

# Insecure-localhost federation transport — DEV / TESTING ONLY. When true, the
# default federation transport rewrites https://localhost:<port> (and 127.0.0.1 /
# [::1]) targets to http:// so two local providers can federate without TLS. NEVER
# enable in production — it only affects loopback, but it has no place on a public
# host. Default false.
# FEDERATION_INSECURE_LOCALHOST=false


# --- Optional features (default OFF) ----------------------------------------

# Known-providers list (§8.6). When true, GET /api/providers serves a shareable
# peer list and discovery advertises sharesKnownProviders: true. Default false
# (endpoint 404s).
# ENABLE_KNOWN_PROVIDERS=false

# Discovery feed (§11.2). When true, GET /api/discover serves a read-time feed of
# local discoverable-tier channels and discovery advertises discoverFeed: true.
# Default false (endpoint 404s).
# ENABLE_DISCOVER_FEED=false
