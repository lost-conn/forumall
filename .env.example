# Forumall self-host configuration. Copy to `.env` and edit:
#
#   cp .env.example .env
#   docker compose up -d
#
# Only DOMAIN is required. Everything else has a sensible default.

# Public authority for this provider — the OFSCP signing authority / `iss` and
# the hostname Caddy obtains a TLS certificate for. MUST be a real public DNS
# name pointing at this host for auto-HTTPS to work. For a local smoke test use
# `localhost` together with the http:// override documented in the Caddyfile.
DOMAIN=forum.example.com

# In-container port the app listens on (Caddy proxies to it). Rarely changed.
PORT=3000

# --- Optional knobs (uncomment to override; see packages/server/src/config.ts
#     for the full list). All have safe defaults. -----------------------------

# Admin contact published in the discovery document, e.g. mailto:admin@...
# CONTACT=mailto:admin@example.com

# Max attachment upload size in bytes (default 25 MiB).
# MAX_UPLOAD_BYTES=26214400

# Federation allow/deny lists (comma-separated domains). Empty = open.
# FEDERATION_ALLOW=
# FEDERATION_DENY=

# Optional feature toggles (default off).
# ENABLE_KNOWN_PROVIDERS=false
# ENABLE_DISCOVER_FEED=false
